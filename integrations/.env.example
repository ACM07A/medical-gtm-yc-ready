# MedYatra GTM engine — environment template. Copy to .env and fill. NEVER commit .env.
# .env is gitignored. Rotate any key that has ever been pasted into a chat/log.

# ---- LLM layer (see integrations/litellm.config.yaml) ----
ANTHROPIC_API_KEY=              # tier-1 strategist (Claude)
NVIDIA_API_KEY=                 # tier-2 bulk builder (GLM 5.2 via https://integrate.api.nvidia.com/v1)

# ---- Content Engine → socials ----
WHATSAPP_TOKEN=                 # WhatsApp Business Platform (Meta Cloud API or BSP: Gupshup/360dialog/Twilio)
WHATSAPP_PHONE_ID=
META_GRAPH_TOKEN=               # Facebook + Instagram publishing (Graph API)
META_AD_ACCOUNT_ID=             # Meta Marketing API (phase 2)
YOUTUBE_OAUTH_CLIENT_ID=        # YouTube Data API v3 (phase 2)
YOUTUBE_OAUTH_CLIENT_SECRET=

# ---- Content Engine → publishing + SEO ----
CMS_BASE_URL=                   # WordPress REST API or headless CMS
CMS_API_KEY=
SEARCH_CONSOLE_CREDENTIALS=     # path to Google service-account json (phase 2)
KEYWORD_API_KEY=                # Ahrefs / Semrush (phase 2)

# ---- Partner + Proposal → email + enrichment ----
ESP_API_KEY=                    # Amazon SES / Postmark / SendGrid / Resend
ESP_FROM_DOMAIN=                # authenticated sending domain (SPF/DKIM/DMARC)
ENRICHMENT_API_KEY=             # Apollo.io / Hunter.io — PUBLIC business contacts only

# ---- Lead / CRM + data core ----
CRM_API_KEY=                    # HubSpot / Airtable
DATABASE_URL=                   # Postgres / Supabase
