# MedYatra GTM engine — environment template. Copy to .env and fill what you need. NEVER commit .env.
# .env is gitignored. Every plugin is wired to work the moment its key is present (see /plugins).
# Rotate any key ever pasted into a chat/log.

# ================= GENERATION =================
# Tier-2 text (cornerstone pages, proposals, social copy). Failover chain: GLM-5.2 -> llama-70b -> llama-8b.
NVIDIA_API_KEY=                 # NVIDIA NIM key — https://build.nvidia.com  (free tier)
# GLM_MODEL=z-ai/glm-5.2        # optional: override primary model
# GLM_FALLBACKS=meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct
# TIER2_TIMEOUT=40000           # per-model ms budget before failover

# Tier-1 strategist (optional; Claude runs the orchestration).
ANTHROPIC_API_KEY=

# Tier-3 small tasks (optional; falls back to the NVIDIA chain if absent).
MINIMAX_API_KEY=

# Image generation — renders Instagram carousel briefs into real images. Auto-picks by whichever key is set
# (priority: gemini > openai > stability > free pollinations fallback). Or force one with IMAGE_PROVIDER.
GEMINI_API_KEY=                 # RECOMMENDED — Gemini 2.5 Flash Image ("Nano Banana"). Key from aistudio.google.com
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=                 # alt — gpt-image-1 / dall-e-3
# OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=             # alt — stable-image core
IMAGE_PROVIDER=                 # optional override: gemini | openai | stability | nvidia | pollinations
# (no key set → free Pollinations fallback, best-effort)

# ================= SOURCING =================
# Verified named decision-maker contacts (the paid unlock for the partner layer). Optional.
HUNTER_API_KEY=                 # Hunter.io  (or ENRICH_API_KEY / Apollo / RocketReach)
# ENRICH_BASE_URL=https://api.hunter.io/v2

# ================= DELIVERY =================
# Global safety switch: publishing adapters DRY-RUN unless POST_LIVE=1 AND per-post approval. Keep unset.
POST_LIVE=

# Email (partner outreach). Without a key, outreach writes .eml files to the local outbox.
RESEND_API_KEY=                 # Resend
RESEND_FROM=                    # verified sending address, e.g. hello@yourdomain.com (needs SPF/DKIM/DMARC)

# Instagram (Meta Graph · Content Publishing). See the /plugins page + Instagram walkthrough.
IG_USER_ID=                     # Instagram Business account ID (fetched via the linked FB Page)
IG_ACCESS_TOKEN=                # long-lived Page/System-User token with instagram_content_publish

# LinkedIn (UGC Posts API).
LINKEDIN_ACCESS_TOKEN=          # OAuth token with w_member_social / w_organization_social
LINKEDIN_AUTHOR_URN=            # urn:li:person:xxxx  or  urn:li:organization:xxxx

# X / Twitter (API v2, write).
X_ACCESS_TOKEN=                 # OAuth2 user-context token with tweet.write (Basic tier)

# Reddit (submit).
REDDIT_ACCESS_TOKEN=            # OAuth token with submit scope
REDDIT_SUBREDDIT=               # target subreddit (respect each sub's self-promo rules)

# WhatsApp broadcast (Meta Cloud API; templates must be pre-approved).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
